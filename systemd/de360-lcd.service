[Unit]
Description=darkFlash DE360 LCD dashboard
After=systemd-udev-settle.service nvidia-persistenced.service
StartLimitIntervalSec=0

[Service]
ExecStart=/opt/de360-lcd/venv/bin/python -I /opt/de360-lcd/de360_dash.py --config /etc/de360-lcd/config.yaml
Restart=on-failure
RestartSec=5
DynamicUser=yes
SupplementaryGroups=plugdev
Nice=10
ProtectSystem=strict
ProtectHome=read-only
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
